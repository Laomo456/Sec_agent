root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,ts,vue}]
indent_style = space
indent_size = 4

[*.{js,cjs,mjs,json,yaml,yml,md,html,css}]
indent_style = space
indent_size = 2

# Windows 批处理必须 CRLF
[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
